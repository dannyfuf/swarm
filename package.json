{
  "name": "swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4"
  },
  "scripts": {
    "dev": "node --experimental-ffi --import tsx src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-ffi --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.5.10",
    "@opentui/react": "0.5.10",
    "react": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
